{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-atoms.com/schemas/composition-v1.json",
  "title": "context-atoms v1 composition",
  "description": "A context composition assembling atoms (situational-frame, environment-descriptor, conversation-scope, working-memory-shape, attention-budget) into a complete context definition consumable by an agent runtime.",
  "type": "object",
  "required": ["schema", "type", "id", "version", "name", "references"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://context-atoms.com/schemas/composition-v1.json"
    },
    "type": { "type": "string", "const": "context" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 }, "uniqueItems": true },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "situational_frame":     { "$ref": "#/$defs/ref" },
        "environment_descriptor":{ "$ref": "#/$defs/ref" },
        "conversation_scope":    { "$ref": "#/$defs/ref" },
        "working_memory_shape":  { "$ref": "#/$defs/ref" },
        "attention_budget":      { "$ref": "#/$defs/ref" }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "version"],
      "additionalProperties": false,
      "properties": {
        "ref":     { "type": "string", "pattern": "^context-atoms://atoms/[a-z-]+/[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" }
      }
    }
  }
}
