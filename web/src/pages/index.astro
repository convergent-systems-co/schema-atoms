---
import { ATOM_CLASSES, getAtomsForClass } from '../lib/catalog';

const classes = ATOM_CLASSES.map((cls) => ({
  name: cls,
  count: getAtomsForClass(cls).length,
})).filter((c) => c.count > 0);

const emptyClasses = ATOM_CLASSES.filter((cls) => getAtomsForClass(cls).length === 0);
const totalAtoms = classes.reduce((sum, c) => sum + c.count, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Canonical schema atoms for the convergent-systems.co atoms ecosystem." />
    <title>schema-atoms</title>
    <link rel="icon" type="image/svg+xml" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/favicon.svg" />
    <link rel="preconnect" href="https://brand-atoms.com" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/css/tokens.css" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/ui/atoms-catalog.css" />
    <style>
      body { min-height: 100vh; }

      .shell { display: grid; grid-template-columns: 1fr 220px; min-height: 100vh; max-width: 1320px; margin: 0 auto; }
      .content { min-width: 0; padding: 32px; }
      .sidenav { position: sticky; top: 0; height: 100vh; padding: 32px 24px; border-left: 1px solid var(--border); display: flex; flex-direction: column; gap: 32px; }

      /* Brand mark in sidenav */
      .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--fg); }
      .mark { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3px; width: 32px; height: 32px; padding: 5px; background: var(--bg-surface); border-radius: 8px; flex-shrink: 0; }
      .dot { width: 100%; height: 100%; border-radius: 50%; }
      .dot-1 { background: #5CD6FF; }
      .dot-2 { background: #F4C75E; }
      .dot-3 { background: #FF8A3D; }
      .dot-4 { background: #EEF1F7; }
      .brand-text { font-weight: 800; font-size: 15px; letter-spacing: -0.02em; line-height: 1.1; }

      .nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
      .nav-link { display: block; padding: 7px 10px; border-radius: 6px; color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 500; }
      .nav-link:hover { background: var(--bg-surface); color: var(--fg); }

      .aside-meta { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border); }
      .meta-link { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--subtle); font-family: var(--font-mono); font-size: 11px; }
      .meta-link:hover { color: var(--cyan); }

      /* Hero */
      .hero { padding: 48px 0 40px; max-width: 680px; }
      .hero-mark { width: 72px; height: 72px; margin-bottom: 28px; }
      .hero h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.04em; margin: 0 0 12px; line-height: 1; }
      .hero h1 span { color: var(--gold); }
      .lede { font-size: 1.05rem; color: var(--muted); margin: 0 0 20px; max-width: 520px; line-height: 1.6; }
      .status { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-family: var(--font-mono); color: var(--subtle); background: var(--bg-surface); padding: 7px 14px; border-radius: 999px; }
      .status-dot { width: 7px; height: 7px; background: var(--cyan); border-radius: 50%; animation: pulse 2.4s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

      /* Stats row */
      .stats { display: grid; grid-template-columns: repeat(3, auto); gap: 24px; padding: 32px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 40px; }
      .stat-value { font-size: 2rem; font-weight: 700; color: var(--cyan); line-height: 1; margin-bottom: 4px; }
      .stat-label { font-size: 11px; font-family: var(--font-mono); color: var(--subtle); text-transform: lowercase; letter-spacing: 0.04em; }

      /* Class list */
      .section-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: var(--subtle); margin: 0 0 12px; }
      ul.class-list { list-style: none; padding: 0; margin: 0 0 2.5rem; }
      ul.class-list li { border-bottom: 1px solid var(--border); }
      ul.class-list li a { display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0; color: var(--fg); text-decoration: none; font-size: 0.9rem; }
      ul.class-list li a:hover { color: var(--cyan); }
      .count { color: var(--subtle); font-size: 0.78rem; font-variant-numeric: tabular-nums; font-family: var(--font-mono); }

      .coming-soon { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0 0 2.5rem; list-style: none; }
      .coming-soon li { font-size: 0.72rem; color: var(--subtle); background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 3px; padding: 0.2em 0.55em; font-family: var(--font-mono); }

      footer { margin-top: 64px; padding: 24px 0; color: var(--subtle); font-size: 12px; border-top: 1px solid var(--border); }
      footer a { color: var(--muted); }

      @media (max-width: 880px) {
        .shell { grid-template-columns: 1fr; }
        .sidenav { position: static; height: auto; border-left: none; border-bottom: 1px solid var(--border); flex-direction: row; align-items: center; padding: 16px 24px; gap: 20px; }
        .nav ul { flex-direction: row; flex-wrap: wrap; }
        .aside-meta { margin-top: 0; padding-top: 0; border-top: none; display: none; }
        .content { padding: 24px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <main class="content">
        <section class="hero">
          <svg class="hero-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" aria-label="atom-family mark" role="img">
            <defs>
              <radialGradient id="s-blue" cx="38%" cy="32%" r="60%"><stop offset="0%" stop-color="#9ad8ff"/><stop offset="40%" stop-color="#3b9fd4"/><stop offset="100%" stop-color="#0a4a7a"/></radialGradient>
              <radialGradient id="s-white" cx="38%" cy="32%" r="60%"><stop offset="0%" stop-color="#ffffff"/><stop offset="50%" stop-color="#c8d0dc"/><stop offset="100%" stop-color="#7a8090"/></radialGradient>
              <radialGradient id="s-orange" cx="38%" cy="32%" r="60%"><stop offset="0%" stop-color="#ffcc88"/><stop offset="40%" stop-color="#e87020"/><stop offset="100%" stop-color="#7a2800"/></radialGradient>
              <radialGradient id="s-cyan" cx="38%" cy="32%" r="60%"><stop offset="0%" stop-color="#aaeeff"/><stop offset="40%" stop-color="#3aaedd"/><stop offset="100%" stop-color="#0a4a6a"/></radialGradient>
              <linearGradient id="tube-h" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#f0f0f0"/><stop offset="40%" stop-color="#d0d4da"/><stop offset="100%" stop-color="#8890a0"/></linearGradient>
            </defs>
            <rect width="400" height="400" fill="#000000" rx="48"/>
            <line x1="80" y1="310" x2="200" y2="220" stroke="url(#tube-h)" stroke-width="22" stroke-linecap="round"/>
            <line x1="200" y1="220" x2="320" y2="310" stroke="url(#tube-h)" stroke-width="22" stroke-linecap="round"/>
            <line x1="200" y1="220" x2="135" y2="95" stroke="url(#tube-h)" stroke-width="22" stroke-linecap="round"/>
            <line x1="200" y1="220" x2="265" y2="95" stroke="url(#tube-h)" stroke-width="22" stroke-linecap="round"/>
            <circle cx="200" cy="80" r="40" fill="url(#s-blue)"/>
            <circle cx="200" cy="220" r="30" fill="url(#s-white)"/>
            <circle cx="80" cy="310" r="38" fill="url(#s-orange)"/>
            <circle cx="320" cy="310" r="38" fill="url(#s-cyan)"/>
          </svg>
          <h1>schema<span>-atoms</span></h1>
          <p class="lede">
            Canonical, versioned schema atoms for the convergent-systems.co ecosystem.
            Machine-readable by AI agents. Human-readable by design.
          </p>
          <span class="status">
            <span class="status-dot"></span>
            {totalAtoms} atoms · {classes.length} classes · draft
          </span>
        </section>

        <div class="stats">
          <div>
            <div class="stat-value">{totalAtoms}</div>
            <div class="stat-label">atoms</div>
          </div>
          <div>
            <div class="stat-value">{classes.length}</div>
            <div class="stat-label">classes</div>
          </div>
          <div>
            <div class="stat-value">{ATOM_CLASSES.length}</div>
            <div class="stat-label">registered types</div>
          </div>
        </div>

        <p class="section-label">Classes</p>
        <ul class="class-list">
          {classes.map(({ name, count }) => (
            <li>
              <a href={`/${name}/`}>
                <span>{name}</span>
                <span class="count">{count}</span>
              </a>
            </li>
          ))}
        </ul>

        {emptyClasses.length > 0 && (
          <>
            <p class="section-label">Coming soon</p>
            <ul class="coming-soon">
              {emptyClasses.map((cls) => <li>{cls}</li>)}
            </ul>
          </>
        )}

        <footer>
          Part of the <a href="https://github.com/convergent-systems-co/atoms">atoms ecosystem</a> &mdash; Apache-2.0 &middot; CC-BY-4.0
        </footer>
      </main>

      <nav class="sidenav">
        <a class="brand" href="/">
          <div class="mark" aria-hidden="true">
            <span class="dot dot-1"></span>
            <span class="dot dot-2"></span>
            <span class="dot dot-3"></span>
            <span class="dot dot-4"></span>
          </div>
          <span class="brand-text">schema-atoms</span>
        </a>

        <div class="nav">
          <ul>
            {classes.map(({ name }) => (
              <li><a class="nav-link" href={`/${name}/`}>{name}</a></li>
            ))}
          </ul>
        </div>

        <div class="aside-meta">
          <a class="meta-link" href="https://github.com/convergent-systems-co/schema-atoms">github ↗</a>
        </div>
      </nav>
    </div>
  </body>
</html>
