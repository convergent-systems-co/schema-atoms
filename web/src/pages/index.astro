---
import { ATOM_CLASSES, getAtomsForClass } from '../lib/catalog';

const classes = ATOM_CLASSES.map((cls) => ({
  name: cls,
  count: getAtomsForClass(cls).length,
})).filter((c) => c.count > 0);

const emptyClasses = ATOM_CLASSES.filter((cls) => getAtomsForClass(cls).length === 0);
const totalAtoms = classes.reduce((sum, c) => sum + c.count, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Canonical schema atoms for the convergent-systems.co atoms ecosystem." />
    <title>schema-atoms</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/brand.css" />
    <style>
      body { min-height: 100vh; padding: 2.5rem 2rem; }
      main { max-width: 44rem; margin: 0 auto; }

      .wordmark { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 0.2rem; color: var(--fg); }
      .wordmark span { color: var(--gold); }
      .meta { color: var(--muted); font-size: 0.875rem; margin: 0 0 2.5rem; }
      .meta a { color: var(--cyan); }
      .meta a:hover { color: var(--cyan-soft); }

      .section-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: var(--subtle); margin: 0 0 0.75rem; }

      ul { list-style: none; padding: 0; margin: 0 0 2.5rem; }
      li { border-bottom: 1px solid var(--border); }
      li a { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 0; color: var(--fg); text-decoration: none; font-size: 0.95rem; }
      li a:hover { color: var(--cyan); }
      .count { color: var(--subtle); font-size: 0.8rem; font-variant-numeric: tabular-nums; font-family: var(--font-mono); }

      .coming-soon { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0 0 2.5rem; list-style: none; }
      .coming-soon li { font-size: 0.75rem; color: var(--subtle); background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 3px; padding: 0.2em 0.55em; font-family: var(--font-mono); }

      footer { color: var(--subtle); margin-top: 3rem; font-size: 0.8rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }
      footer a { color: var(--cyan); }
    </style>
  </head>
  <body>
    <main>
      <h1 class="wordmark">schema<span>-atoms</span></h1>
      <p class="meta">
        {totalAtoms} atom{totalAtoms !== 1 ? 's' : ''} &middot; {classes.length} class{classes.length !== 1 ? 'es' : ''} &middot;
        <a href="https://github.com/convergent-systems-co/schema-atoms">github</a>
      </p>

      <p class="section-label">Classes</p>
      <ul>
        {classes.map(({ name, count }) => (
          <li>
            <a href={`/${name}/`}>
              <span>{name}</span>
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>

      {emptyClasses.length > 0 && (
        <>
          <p class="section-label">Coming soon</p>
          <ul class="coming-soon">
            {emptyClasses.map((cls) => <li>{cls}</li>)}
          </ul>
        </>
      )}

      <footer>
        Part of the <a href="https://github.com/convergent-systems-co/atoms">atoms ecosystem</a> &mdash; Apache-2.0 &middot; CC-BY-4.0
      </footer>
    </main>
  </body>
</html>
