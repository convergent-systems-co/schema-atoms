---
import { ATOM_CLASSES, getAtomsForClass } from '../lib/catalog';

const classes = ATOM_CLASSES.map((cls) => ({
  name: cls,
  count: getAtomsForClass(cls).length,
})).filter((c) => c.count > 0);

const emptyClasses = ATOM_CLASSES.filter((cls) => getAtomsForClass(cls).length === 0);
const totalAtoms = classes.reduce((sum, c) => sum + c.count, 0);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Canonical schema atoms for the convergent-systems.co atoms ecosystem." />
    <title>schema-atoms</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      :root {
        --bg: #0b0d10;
        --fg: #e8e8e6;
        --muted: #7a8088;
        --accent: #ffb86c;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body { min-height: 100vh; padding: 2rem; line-height: 1.5; }
      main { max-width: 42rem; margin: 0 auto; }
      h1 { font-size: clamp(1.75rem, 5vw, 2.5rem); margin: 0 0 0.25rem; font-weight: 600; letter-spacing: -0.03em; }
      .meta { color: var(--muted); font-size: 0.875rem; margin: 0 0 2rem; }
      .meta a { color: var(--accent); text-decoration: none; }
      .meta a:hover { text-decoration: underline; }
      h2 { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.75rem; }
      ul { list-style: none; padding: 0; margin: 0 0 2.5rem; }
      li { border-bottom: 1px solid #1f242a; }
      li a { display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0; color: var(--fg); text-decoration: none; }
      li a:hover { color: var(--accent); }
      .count { color: var(--muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
      .empty-list { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; list-style: none; }
      .empty-list li { font-size: 0.8rem; color: var(--muted); background: #11141a; border: 1px solid #1f242a; border-radius: 3px; padding: 0.2em 0.5em; }
      footer { color: var(--muted); margin-top: 3rem; font-size: 0.875rem; border-top: 1px solid #1f242a; padding-top: 1.5rem; }
      footer a { color: var(--accent); text-decoration: none; }
      footer a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <main>
      <h1>schema-atoms</h1>
      <p class="meta">
        {totalAtoms} atom{totalAtoms !== 1 ? 's' : ''} across {classes.length} class{classes.length !== 1 ? 'es' : ''} &mdash;
        <a href="https://github.com/convergent-systems-co/schema-atoms">github</a>
      </p>

      <h2>Classes</h2>
      <ul>
        {classes.map(({ name, count }) => (
          <li>
            <a href={`/${name}/`}>
              <span>{name}</span>
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>

      {emptyClasses.length > 0 && (
        <>
          <h2>Coming soon</h2>
          <ul class="empty-list">
            {emptyClasses.map((cls) => <li>{cls}</li>)}
          </ul>
        </>
      )}

      <footer>
        Part of the <a href="https://github.com/convergent-systems-co/atoms">atoms ecosystem</a>.
        Apache-2.0.
      </footer>
    </main>
  </body>
</html>
