---
import { ATOM_CLASSES, getAtomsForClass, parseAtomFilename } from '../../lib/catalog';

export function getStaticPaths() {
  return ATOM_CLASSES.map((c) => ({ params: { class: c } }));
}

const { class: atomClass } = Astro.params;
const atomFiles = getAtomsForClass(atomClass);
const atoms = atomFiles.map(parseAtomFilename);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`All atoms in the ${atomClass} class`} />
    <title>{atomClass} — schema-atoms</title>
    <style>
      :root {
        --bg: #0b0d10;
        --fg: #e8e8e6;
        --muted: #7a8088;
        --accent: #ffb86c;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body { min-height: 100vh; padding: 2rem; line-height: 1.5; }
      main { max-width: 42rem; margin: 0 auto; }
      h1 { font-size: clamp(1.75rem, 5vw, 2.5rem); margin: 0 0 0.5rem; font-weight: 600; letter-spacing: -0.03em; }
      .breadcrumb { color: var(--muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
      .breadcrumb a { color: var(--accent); text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .empty { border: 1px solid #1f242a; border-left: 3px solid var(--muted); padding: 1rem 1.25rem; background: #11141a; border-radius: 4px; color: var(--muted); }
      ul { list-style: none; padding: 0; margin: 0; }
      li { border-bottom: 1px solid #1f242a; }
      li a { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; color: var(--fg); text-decoration: none; }
      li a:hover { color: var(--accent); }
      .slug { font-weight: 500; }
      .version { color: var(--muted); font-size: 0.875rem; }
    </style>
  </head>
  <body>
    <main>
      <p class="breadcrumb"><a href="/">schema-atoms</a> / {atomClass}</p>
      <h1>{atomClass}</h1>
      {atoms.length === 0
        ? <p class="empty">No atoms published yet.</p>
        : (
          <ul>
            {atoms.map(({ slug, version }) => (
              <li>
                <a href={`/${atomClass}/${slug}/`}>
                  <span class="slug">{slug}</span>
                  <span class="version">{version}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
