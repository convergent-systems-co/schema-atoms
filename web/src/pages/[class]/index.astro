---
import { ATOM_CLASSES, getAtomsForClass, parseAtomFilename } from '../../lib/catalog';

export function getStaticPaths() {
  return ATOM_CLASSES.map((c) => ({ params: { class: c } }));
}

const { class: atomClass } = Astro.params;
const atomFiles = getAtomsForClass(atomClass);
const atoms = atomFiles.map(parseAtomFilename);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`All atoms in the ${atomClass} class — schema-atoms`} />
    <title>{atomClass} — schema-atoms</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/brand.css" />
    <style>
      body { min-height: 100vh; padding: 2.5rem 2rem; }
      main { max-width: 44rem; margin: 0 auto; }

      .breadcrumb { color: var(--subtle); font-size: 0.8rem; margin-bottom: 1.75rem; }
      .breadcrumb a { color: var(--cyan); }
      .breadcrumb a:hover { color: var(--cyan-soft); }

      h1 { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 2rem; color: var(--fg); }

      .empty { border: 1px solid var(--border); border-left: 3px solid var(--border-strong); padding: 1rem 1.25rem; background: var(--bg-surface); border-radius: 4px; color: var(--muted); font-size: 0.9rem; }

      ul { list-style: none; padding: 0; margin: 0; }
      li { border-bottom: 1px solid var(--border); }
      li:first-child { border-top: 1px solid var(--border); }
      li a { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; color: var(--fg); text-decoration: none; }
      li a:hover { color: var(--cyan); }
      .slug { font-weight: 500; font-size: 0.95rem; }
      .version { color: var(--subtle); font-size: 0.8rem; font-family: var(--font-mono); }
    </style>
  </head>
  <body>
    <main>
      <p class="breadcrumb"><a href="/">schema-atoms</a> / {atomClass}</p>
      <h1>{atomClass}</h1>
      {atoms.length === 0
        ? <p class="empty">No atoms published yet.</p>
        : (
          <ul>
            {atoms.map(({ slug, version }) => (
              <li>
                <a href={`/${atomClass}/${slug}/`}>
                  <span class="slug">{slug}</span>
                  <span class="version">{version}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
