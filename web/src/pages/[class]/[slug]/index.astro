---
import { ATOM_CLASSES, getAtomsForClass, parseAtomFilename } from '../../../lib/catalog';

export function getStaticPaths() {
  return ATOM_CLASSES.flatMap((c) =>
    getAtomsForClass(c).map((filename) => {
      const { slug } = parseAtomFilename(filename);
      return { params: { class: c, slug } };
    })
  );
}

const { class: atomClass, slug } = Astro.params;
// Collect all versions of this slug within this class
const allFiles = getAtomsForClass(atomClass);
const versions = allFiles
  .map(parseAtomFilename)
  .filter((a) => a.slug === slug)
  .map((a) => a.version);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Version history for ${slug} in ${atomClass}`} />
    <title>{slug} — {atomClass} — schema-atoms</title>
    <style>
      :root {
        --bg: #0b0d10;
        --fg: #e8e8e6;
        --muted: #7a8088;
        --accent: #ffb86c;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body { min-height: 100vh; padding: 2rem; line-height: 1.5; }
      main { max-width: 42rem; margin: 0 auto; }
      h1 { font-size: clamp(1.75rem, 5vw, 2.5rem); margin: 0 0 0.5rem; font-weight: 600; letter-spacing: -0.03em; }
      .breadcrumb { color: var(--muted); font-size: 0.875rem; margin-bottom: 1.5rem; }
      .breadcrumb a { color: var(--accent); text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      ul { list-style: none; padding: 0; margin: 0; }
      li { border-bottom: 1px solid #1f242a; }
      li a { display: block; padding: 0.75rem 0; color: var(--accent); text-decoration: none; font-weight: 500; }
      li a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <main>
      <p class="breadcrumb">
        <a href="/">schema-atoms</a> /
        <a href={`/${atomClass}/`}>{atomClass}</a> /
        {slug}
      </p>
      <h1>{slug}</h1>
      <p>Class: {atomClass}</p>
      {versions.length > 0 && (
        <ul>
          {versions.map((v) => (
            <li>
              <a href={`/${atomClass}/${slug}/${v}/`}>{v}</a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
